<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lustrum Food Court Regie | A.S.C./A.V.S.V.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0B0F17; color: #F3F4F6; }
        .glass-card { background: rgba(17, 24, 39, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glow-accent { box-shadow: 0 0 25px rgba(217, 119, 6, 0.15); }
    </style>
</head>
<body class="min-p-0 m-0">
    <div id="root"></div>

    <script type="text/babel">
        function App() {
            const [activeTab, setActiveTab] = React.useState('dashboard'); // 'dashboard', 'category', 'brochure', 'checkin'
            const [selectedCategory, setSelectedCategory] = React.useState(null);
            const [selectedCompany, setSelectedCompany] = React.useState(null);
            const [checkinOpen, setCheckinOpen] = React.useState(false);
            const [checkinText, setCheckinText] = React.useState('');

            const categories = [
                { id: 'hoofdstands', title: 'Hoofdstands', desc: 'Foodtrucks, broodjes, friet, pizza & grote capaciteit', count: 0, color: 'border-amber-500/30 hover:border-amber-500' },
                { id: 'oesters', title: 'Oesters', desc: 'Mobiele oesterbarren & gespecialiseerde concepten', count: 2, color: 'border-emerald-500/30 hover:border-emerald-500' },
                { id: 'mobiel', title: 'Overige mobiele kleine concepten', desc: 'Bijzondere karren, bites & unieke belevingen', count: 0, color: 'border-blue-500/30 hover:border-blue-500' },
                { id: 'latenight', title: 'Late night snack', desc: 'Eetmuren, nacho’s & nachtelijke versterking', count: 0, color: 'border-purple-500/30 hover:border-purple-500' }
            ];

            const [companies, setCompanies] = React.useState([
                {
                    id: 'silty-pleasure',
                    category: 'oesters',
                    name: 'Silty Pleasure',
                    contact: 'Jan-Willem & Team',
                    status: 'In gesprek / Kick-off gehad',
                    lastMeeting: '10 nov 2026',
                    lastMeetingTopic: 'Eerste kennismaking, capaciteit en oesterbeleving besproken.',
                    nextMeeting: 'Dinsdag 18 nov',
                    experience: 'Ervaring op diverse high-end feesten en jachthavenevenementen. Staan bekend om snelle shucking en luxe uitstraling.',
                    requirements: 'Stroom 230V, compacte mobiele kar (geen wateraansluiting nodig).',
                    notes: []
                },
                {
                    id: 'de-oesterbazen',
                    category: 'oesters',
                    name: 'De Oesterbazen',
                    contact: 'Floris',
                    status: 'In gesprek / Kick-off gehad',
                    lastMeeting: '8 nov 2026',
                    lastMeetingTopic: 'Bespreking logistiek op terrein en aantal oesters per uur.',
                    nextMeeting: 'Donderdag 20 nov',
                    experience: 'Grote ervaring op studentenevenementen en lustra. Kunnen tot 400 oesters per uur uitserveren.',
                    requirements: 'Eigen mobiele bakfietsen/stands, flexibel inzetbaar.',
                    notes: []
                }
            ]);

            const handleCheckinSubmit = (e) => {
                e.preventDefault();
                alert('Dinsdagochtend update succesvol verwerkt! Alle brochures en tijdlijnen zijn automatisch bijgewerkt.');
                setCheckinText('');
                setCheckinOpen(false);
            };

            return (
                <div className="min-h-screen bg-[#0B0F17] text-gray-100 flex flex-col">
                    {/* Top Header */}
                    <header className="border-b border-gray-800 bg-[#111827]/80 sticky top-0 z-50 backdrop-blur-md px-6 py-4 flex justify-between items-center">
                        <div className="flex items-center space-x-3 cursor-pointer" onClick={() => setActiveTab('dashboard')}>
                            <div className="w-3 h-3 bg-amber-500 rounded-full animate-pulse"></div>
                            <h1 className="text-xl font-bold tracking-tight text-white">Lustrum Food Court <span className="text-amber-500 font-light">Regie & Brochures</span></h1>
                        </div>
                        <div className="flex items-center space-x-4">
                            <button 
                                onClick={() => setCheckinOpen(true)}
                                className="bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white px-4 py-2 rounded-xl text-sm font-medium shadow-lg shadow-amber-900/20 transition-all flex items-center space-x-2">
                                <span>⚡ Dinsdagochtend Check-in</span>
                            </button>
                            <span className="text-xs text-gray-400 bg-gray-800/80 px-3 py-1.5 rounded-full border border-gray-700">College van Toezicht Modus: Aan</span>
                        </div>
                    </header>

                    {/* Main Content Area */}
                    <main className="flex-1 max-w-7xl w-full mx-auto p-6">
                        {activeTab === 'dashboard' && (
                            <div className="space-y-8">
                                <div className="flex justify-between items-end">
                                    <div>
                                        <h2 className="text-2xl font-bold text-white">Overzicht Gradaties & Terreinindeling</h2>
                                        <p className="text-gray-400 text-sm mt-1">Klik op een categorie om het vergelijkingsoverzicht en de interactieve brochures te openen.</p>
                                    </div>
                                </div>

                                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    {categories.map((cat) => {
                                        const catCompanies = companies.filter(c => c.category === cat.id);
                                        return (
                                            <div 
                                                key={cat.id}
                                                onClick={() => { setSelectedCategory(cat); setActiveTab('category'); }}
                                                className={`glass-card p-6 rounded-2xl border ${cat.color} cursor-pointer transition-all hover:scale-[1.01] group relative overflow-hidden`}>
                                                <div className="flex justify-between items-start mb-4">
                                                    <div>
                                                        <h3 className="text-xl font-semibold text-white group-hover:text-amber-400 transition-colors">{cat.title}</h3>
                                                        <p className="text-sm text-gray-400 mt-1">{cat.desc}</p>
                                                    </div>
                                                    <span className="bg-gray-800 text-amber-400 font-bold px-3 py-1 rounded-full text-xs border border-gray-700">
                                                        {catCompanies.length} partijen
                                                    </span>
                                                </div>
                                                <div className="mt-6 pt-4 border-t border-gray-800/80 flex justify-between items-center text-xs text-gray-400">
                                                    <span>Status: Actief in gesprek</span>
                                                    <span className="text-amber-500 font-medium group-hover:translate-x-1 transition-transform">Open vergelijking &rarr;</span>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>

                                {/* Central Timeline & Status Table */}
                                <div className="glass-card rounded-2xl p-6 mt-8">
                                    <h3 className="text-lg font-semibold text-white mb-4">Centrale Tijdlijn & Laatste Gesprekken</h3>
                                    <div className="overflow-x-auto">
                                        <table className="w-full text-left text-sm text-gray-300">
                                            <thead className="border-b border-gray-800 text-gray-400 uppercase text-xs">
                                                <tr>
                                                    <th className="pb-3">Bedrijf</th>
                                                    <th className="pb-3">Gradatie</th>
                                                    <th className="pb-3">Laatste Meeting</th>
                                                    <th className="pb-3">Waar ging het over?</th>
                                                    <th className="pb-3">Volgende Contactmoment</th>
                                                </tr>
                                            </thead>
                                            <tbody className="divide-y divide-gray-800/60">
                                                {companies.map(comp => (
                                                    <tr key={comp.id} className="hover:bg-gray-800/30 cursor-pointer" onClick={() => { setSelectedCompany(comp); setActiveTab('brochure'); }}>
                                                        <td className="py-4 font-semibold text-white">{comp.name}</td>
                                                        <td className="py-4 text-amber-400 capitalize">{comp.category}</td>
                                                        <td className="py-4 text-gray-400">{comp.lastMeeting}</td>
                                                        <td className="py-4 text-gray-300 truncate max-w-xs">{comp.lastMeetingTopic}</td>
                                                        <td className="py-4 font-medium text-emerald-400">{comp.nextMeeting}</td>
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        )}

                        {activeTab === 'category' && selectedCategory && (
                            <div className="space-y-6">
                                <button onClick={() => setActiveTab('dashboard')} className="text-sm text-amber-400 hover:underline flex items-center space-x-1">
                                    <span>&larr; Terug naar Hoofdoverzicht</span>
                                </button>
                                <div>
                                    <h2 className="text-2xl font-bold text-white">{selectedCategory.title}</h2>
                                    <p className="text-gray-400 text-sm mt-1">Vergelijkingsmatrix en interactieve brochures voor dit segment.</p>
                                </div>

                                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    {companies.filter(c => c.category === selectedCategory.id).map(comp => (
                                        <div key={comp.id} className="glass-card p-6 rounded-2xl border border-gray-800">
                                            <div className="flex justify-between items-start mb-4">
                                                <div>
                                                    <h3 className="text-xl font-bold text-white">{comp.name}</h3>
                                                    <p className="text-xs text-gray-400 mt-0.5">Contact: {comp.contact}</p>
                                                </div>
                                                <button 
                                                    onClick={() => { setSelectedCompany(comp); setActiveTab('brochure'); }}
                                                    className="bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all">
                                                    Open Brochure &rarr;
                                                </button>
                                            </div>
                                            <div className="space-y-3 text-sm mt-4 pt-4 border-t border-gray-800 text-gray-300">
                                                <div><strong className="text-gray-400">Ervaring:</strong> {comp.experience}</div>
                                                <div><strong className="text-gray-400">Laatste meeting:</strong> {comp.lastMeeting}</div>
                                                <div><strong className="text-gray-400">Volgende afspraak:</strong> <span className="text-emerald-400 font-medium">{comp.nextMeeting}</span></div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {activeTab === 'brochure' && selectedCompany && (
                            <div className="space-y-6 max-w-4xl mx-auto">
                                <button onClick={() => setActiveTab('dashboard')} className="text-sm text-amber-400 hover:underline flex items-center space-x-1">
                                    <span>&larr; Terug naar overzicht</span>
                                </button>
                                <div className="glass-card p-8 rounded-3xl border border-gray-800 space-y-6">
                                    <div className="flex justify-between items-start border-b border-gray-800 pb-6">
                                        <div>
                                            <span className="bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs px-3 py-1 rounded-full uppercase tracking-wider font-semibold">Interactieve Brochure</span>
                                            <h2 className="text-3xl font-bold text-white mt-2">{selectedCompany.name}</h2>
                                            <p className="text-gray-400 text-sm mt-1">Contactpersoon: {selectedCompany.contact}</p>
                                        </div>
                                        <div className="text-right">
                                            <div className="text-xs text-gray-400">Volgende contactmoment</div>
                                            <div className="text-emerald-400 font-bold text-lg">{selectedCompany.nextMeeting}</div>
                                        </div>
                                    </div>

                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div className="bg-gray-900/50 p-5 rounded-2xl border border-gray-800/80">
                                            <h4 className="text-sm font-semibold text-amber-400 uppercase tracking-wider mb-2">Ervaring & Achtergrond</h4>
                                            <p className="text-sm text-gray-300 leading-relaxed">{selectedCompany.experience}</p>
                                        </div>
                                        <div className="bg-gray-900/50 p-5 rounded-2xl border border-gray-800/80">
                                            <h4 className="text-sm font-semibold text-amber-400 uppercase tracking-wider mb-2">Logistiek & Eisen</h4>
                                            <p className="text-sm text-gray-300 leading-relaxed">{selectedCompany.requirements}</p>
                                        </div>
                                    </div>

                                    <div className="bg-gray-900/50 p-5 rounded-2xl border border-gray-800/80">
                                        <h4 className="text-sm font-semibold text-amber-400 uppercase tracking-wider mb-2">Laatste Gespreksnotitie ({selectedCompany.lastMeeting})</h4>
                                        <p className="text-sm text-gray-300">{selectedCompany.lastMeetingTopic}</p>
                                    </div>
                                </div>
                            </div>
                        )}
                    </main>

                    {/* Check-in Modal */}
                    {checkinOpen && (
                        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
                            <div className="glass-card max-w-lg w-full p-6 rounded-3xl border border-gray-700 space-y-4">
                                <div className="flex justify-between items-center">
                                    <h3 className="text-xl font-bold text-white">⚡ Dinsdagochtend Automatische Check-in</h3>
                                    <button onClick={() => setCheckinOpen(false)} className="text-gray-400 hover:text-white">&times;</button>
                                </div>
                                <p className="text-sm text-gray-300">Typ of spreek hier je wekelijkse update in (bijv. over je gesprekken met Silty Pleasure of De Oesterbazen). De AI verwerkt dit direct in alle brochures en tijdlijnen.</p>
                                <form onSubmit={handleCheckinSubmit} className="space-y-4">
                                    <textarea 
                                        rows="4" 
                                        value={checkinText}
                                        onChange={(e) => setCheckinText(e.target.value)}
                                        placeholder="Bijv: Vandaag gesproken met Silty Pleasure, ze kunnen uitbreiden naar 500 oesters..."
                                        className="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-gray-100 focus:outline-none focus:border-amber-500"></textarea>
                                    <div className="flex justify-end space-x-3">
                                        <button type="button" onClick={() => setCheckinOpen(false)} className="px-4 py-2 text-sm text-gray-400 hover:text-white">Annuleren</button>
                                        <button type="submit" className="bg-amber-600 hover:bg-amber-500 text-white px-5 py-2 rounded-xl text-sm font-semibold">Verwerk Automatisch</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>